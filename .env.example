# MarketPilot Step 1 runs fully offline. No API keys are required.
# Execution mode: mock keeps the deterministic mock-agent demo; llm enables the LLM runtime.
MARKETPILOT_MODE=mock
MARKETPILOT_RUNS_DIR=runs
MARKETPILOT_LOG_LEVEL=INFO

# LLM provider configuration (only required for --mode llm --provider openai).
MARKETPILOT_LLM_PROVIDER=openai
MARKETPILOT_LLM_MODEL=gpt-4o-mini
MARKETPILOT_LLM_API_KEY=
MARKETPILOT_LLM_BASE_URL=
MARKETPILOT_LLM_TIMEOUT_SECONDS=30
MARKETPILOT_LLM_MAX_RETRIES=2
MARKETPILOT_LLM_TEMPERATURE=0.0
MARKETPILOT_LLM_MAX_OUTPUT_TOKENS=1024
MARKETPILOT_LLM_MAX_MODEL_TURNS=4
MARKETPILOT_LLM_MAX_TOOL_CALLS=8
MARKETPILOT_LLM_MAX_CALLS_PER_TASK=12
MARKETPILOT_LLM_MAX_ROLLOUT_COUNT=4

# Research environment (mock/live/replay). Live search requires a provider key.
MARKETPILOT_RESEARCH_MODE=mock
MARKETPILOT_SEARCH_PROVIDER=tavily
MARKETPILOT_SEARCH_API_KEY=
MARKETPILOT_RETRIEVAL_TIMEOUT_SECONDS=10
MARKETPILOT_MAX_PAGE_BYTES=1000000
MARKETPILOT_MAX_SEARCH_RESULTS=5
MARKETPILOT_DATASETS_DIR=datasets
MARKETPILOT_BENCHMARK_RUNS_DIR=benchmark_runs
MARKETPILOT_DATABASE_URL=sqlite:///marketpilot.db
